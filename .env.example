# Copy to .env for local development.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/acalyze
JWT_SECRET=change-me-to-a-long-random-string
PORT=3001

# Your own platform-admin sign-in (created on first boot of an empty database)
PLATFORM_ADMIN_EMAIL=you@example.com
PLATFORM_ADMIN_PASSWORD=pick-something-strong
PLATFORM_ADMIN_NAME=Platform Admin

# Shown to schools on their Subscription page (your M-Pesa Paybill)
PAYBILL_NUMBER=
APP_URL=http://localhost:3001

# Shown at the bottom of every school admin's screen as Acalyze support
SUPPORT_EMAIL=
SUPPORT_PHONE=

# Optional: emails (password resets) through Resend
RESEND_API_KEY=
MAIL_FROM=

# true = also create a demo school: admin@demo.acalyze.app / Demo@2026
SEED_DEMO=true

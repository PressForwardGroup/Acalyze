# Copy to .env for local development.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/acalyze
JWT_SECRET=change-me-to-a-long-random-string
PORT=3001

# Your own platform-admin sign-in (created on first boot of an empty database)
PLATFORM_ADMIN_EMAIL=you@example.com
PLATFORM_ADMIN_PASSWORD=pick-something-strong
PLATFORM_ADMIN_NAME=Platform Admin

# Shown to schools on their Subscription page (your M-Pesa Paybill)
PAYBILL_NUMBER=
APP_URL=http://localhost:3001

# Shown at the bottom of every school admin's screen as Acalyze support
SUPPORT_EMAIL=
SUPPORT_PHONE=

# M-Pesa (see MPESA.md). Encrypts each school's Daraja keys before they are stored.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it safe and never change it: if it is lost, schools must enter their keys again.
MPESA_SECRET_KEY=

# Android app (see ANDROID.md). Fill these in after you build the app.
ANDROID_PACKAGE_NAME=
ANDROID_SHA256=

# The public website's address (a separate site). The app links to it and booking emails point to it.
SITE_URL=

# Website booking (all optional, see WEBSITE.md)
NOTIFY_EMAIL=            # where new booking alerts are emailed (defaults to PLATFORM_ADMIN_EMAIL)
MEET_LINK=               # your Google Meet link, sent to people who book a video call
OFFICE_ADDRESS=          # shown for face-to-face meetings
BOOKING_DAYS=1,2,3,4,5   # 0 = Sunday ... 6 = Saturday
BOOKING_START_HOUR=9
BOOKING_END_HOUR=17
BOOKING_SLOT_MINUTES=30
BOOKING_LEAD_HOURS=4     # no bookings sooner than this
BOOKING_MAX_DAYS=30      # how far ahead people can book

# Optional: emails (password resets) through Resend
RESEND_API_KEY=
MAIL_FROM=

# true = also create a demo school: admin@demo.acalyze.app / Demo@2026
SEED_DEMO=true

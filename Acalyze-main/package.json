{
  "name": "acalyze",
  "version": "0.1.0",
  "description": "Acalyze: multi-school exam results, report cards and analytics (8-4-4 and CBC)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch-path=src src/server.js",
    "start": "node src/server.js",
    "migrate": "bash -c 'set -a; source .env; set +a; psql \"$DATABASE_URL\" -f db/schema.sql'",
    "seed": "node src/scripts/seed.js",
    "test": "node test/run.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=20"
  }
}
